#!/usr/bin/env zsh
# devws: the command (~/.local/bin/devws, linked by ./install.sh). An
# executable rather than a shell function, so every open pane runs the
# checkout's current version — no `source ~/.zshrc` after an update. The
# prompt and EDITOR settings stay in shell/devws.zsh.
#
# Each run first links devws scripts an update added to ~/.tmuxinator
# (link_scripts.sh), so they work without re-running ./install.sh.

# The checkout, through the ~/.local/bin link.
devws_checkout="${0:A:h:h}"
# For the scripts that call devws back (agentic.sh).
export DEVWS_BIN="$devws_checkout/bin/devws"
"$devws_checkout/config/tmuxinator/link_scripts.sh" >/dev/null 2>&1

devws() {
  if [[ "${1:-}" == "md" ]]; then
    shift
    devws-markdown "$@"
    return
  fi

  # The guide (docs/guide/): `devws help [page]`.
  if [[ "${1:-}" == "help" ]]; then
    "$devws_checkout/config/tmuxinator/guide.sh" "${@:2}"
    return
  fi

  if [[ "${1:-}" == "menu" ]]; then
    devws-menu "${2:-toggle}" "${3:-}"
    return
  fi

  if [[ "${1:-}" == "restore" ]]; then
    devws-restore "${@:2}"
    return
  fi

  if [[ "${1:-}" == "save" ]]; then
    "$HOME/.tmuxinator/save_state.sh"
    return
  fi

  if [[ "${1:-}" == "reload" ]]; then
    "$HOME/.tmuxinator/reload_devws.sh"
    return
  fi

  # For a program driving devws (devAgentics): a workspace without the start
  # screen or any question, and the agents in the workspaces.
  if [[ "${1:-}" == "open" ]]; then
    devws-workspace --folder-required "${@:2}"
    return
  fi

  if [[ "${1:-}" == "agentic" ]]; then
    "$HOME/.tmuxinator/agentic.sh" "${@:2}"
    return
  fi

  if [[ "${1:-}" == "agent" ]]; then
    "$HOME/.tmuxinator/agent_cli.sh" "${@:2}"
    return
  fi

  if [[ "${1:-}" == "network" ]]; then
    "$HOME/.tmuxinator/network.sh" "${@:2}"
    return
  fi

  if [[ "${1:-}" == "worktree" && "${2:-}" == "ensure" ]]; then
    devws-worktree-ensure "${@:3}"
    return
  fi

  # A workspace on a git worktree of the current folder's repo, next to it
  # (../<repo>-<branch>): the branch's worktree when there is one, else the
  # branch checked out there, or a new branch off HEAD.
  if [[ "${1:-}" == "worktree" ]]; then
    if [[ -z "${2:-}" ]]; then
      print -u2 "usage: devws worktree <branch> [agent] [editor]"
      return 2
    fi
    local worktree_folder
    worktree_folder="$("$HOME/.tmuxinator/worktree.sh" ensure "$PWD" "$2")" || return
    devws "$worktree_folder" "${@:3}"
    return
  fi

  if [[ "${1:-}" == "run" || "${1:-}" == "stop" ]]; then
    devws-run "$@"
    return
  fi

  if [[ "${1:-}" == "commit" ]]; then
    "$HOME/.tmuxinator/git_actions.sh" "$@"
    return
  fi

  if [[ "${1:-}" == "push" ]]; then
    devws-push
    return
  fi

  # Background jobs (job.sh), shown in the header: `devws job <title>
  # [--lock <name>]... -- <command>`, `devws note <text> [--error]`.
  if [[ "${1:-}" == "job" || "${1:-}" == "note" ]]; then
    local job_command="${1/job/start}"
    "$HOME/.tmuxinator/job.sh" "$job_command" "${@:2}"
    return
  fi

  if [[ "${1:-}" == "jobs" ]]; then
    devws-jobs "${@:2}"
    return
  fi

  if [[ "${1:-}" == "memory" ]]; then
    devws-memory "${@:2}"
    return
  fi

  # No folder: the start screen — a folder opened before, with the agent and
  # editor it had (recent.sh), or a branch of a GitHub repo (one on GitHub or
  # a new one), which asks for them. `devws .` opens the current folder.
  if (( $# == 0 )); then
    local github_folder
    github_folder="$("$HOME/.tmuxinator/github_workspace.sh")" || return
    devws "$github_folder" ${=$("$HOME/.tmuxinator/recent.sh" get "$github_folder")}
    return
  fi

  if [[ "${1:-}" == "tidy" ]]; then
    "$HOME/.tmuxinator/tidy.sh"
    return
  fi

  if [[ "${1:-}" == "detach" ]]; then
    tmux detach-client
    return
  fi

  if [[ "${1:-}" == "fresh" ]]; then
    rm -f "$HOME/.devws-state/sessions.tsv"
    print "devws: saved workspaces cleared"
    return
  fi

  devws-workspace "$@"
}

# The prompts, the folder and the saved state of one workspace. Options, for a
# program driving devws (devAgentics):
#   --no-attach          starts it detached and never asks for the agent or the
#                        editor (the defaults apply); prints the session's name
#   --task <id>          groups it under a task in the sidebar, and keeps it
#                        out of the start screen's recent folders
#   --agent-args <file>  more arguments for the agent (agent_runner.sh)
#   --folder-required    `devws open`: no folder is an error, not this one
#   --template <name>    start ~/.tmuxinator/<name>.yml instead of dev.yml (an
#                        agent team: agentic.yml); the editor is not asked for
#   --set <key=value>    one more setting for that template (repeatable)
devws-workspace() {
  local attach=1 task="" agent_args="" folder_required=0 template=dev
  local -a extra_settings=()
  while [[ "${1:-}" == --* ]]; do
    case "$1" in
      --no-attach) attach=0 ;;
      --folder-required) folder_required=1 ;;
      --task | --agent-args | --template | --set)
        if [[ -z "${2:-}" ]]; then
          print -u2 "devws: $1 needs a value"
          return 2
        fi
        case "$1" in
          --task) task="$2" ;;
          --agent-args) agent_args="$2" ;;
          --template) template="$2" ;;
          --set) extra_settings+=("$2") ;;
        esac
        shift
        ;;
      *)
        print -u2 "devws: unknown option: $1"
        return 2
        ;;
    esac
    shift
  done
  if (( folder_required )) && [[ -z "${1:-}" ]]; then
    print -u2 "usage: devws open [--no-attach] [--task <id>] [--agent-args <file>] <folder> [agent] [editor]"
    return 2
  fi
  if [[ ! "$template" =~ ^[a-z][a-z0-9_-]*$ || ! -r "$HOME/.tmuxinator/$template.yml" ]]; then
    print -u2 "devws: no such template: $template"
    return 2
  fi
  if [[ -n "$task" && ! "$task" =~ ^[A-Za-z0-9._-]+$ ]]; then
    print -u2 "devws: a task id uses letters, digits, . _ and -: $task"
    return 2
  fi
  if [[ -n "$agent_args" ]]; then
    if [[ ! -r "$agent_args" ]]; then
      print -u2 "devws: cannot read the agent arguments: $agent_args"
      return 1
    fi
    agent_args="${agent_args:A}"
  fi

  local project_root
  # Resolve to an absolute, symlink-free path before handing it to
  # tmuxinator. A relative value (e.g. "." from `devws .`) would otherwise
  # be stored as-is and re-resolved inconsistently by tmux later, producing
  # broken pane working directories.
  if ! project_root="$(cd "${1:-$PWD}" 2>/dev/null && pwd -P)"; then
    print -u2 "devws: folder does not exist: ${1:-$PWD}"
    return 1
  fi
  local agent="${2:-}"
  local editor="${3:-}"
  local agent_config="$HOME/.tmuxinator/.env"

  if [[ -r "$agent_config" ]]; then
    source "$agent_config"
  fi

  local -a available_agents
  available_agents=(${=DEVWS_AGENTS:-claude codex})

  if [[ -z "$agent" ]] && (( attach )) && [[ -t 0 && -t 1 && -x "$(command -v fzf)" ]]; then
    agent="$(printf '%s\n' "${available_agents[@]}" | fzf \
      --height=~10 --layout=reverse --prompt='Agent > ')"
    [[ -n "$agent" ]] || return 0
  fi
  agent="${agent:-${DEVWS_DEFAULT_AGENT:-${available_agents[1]}}}"

  if (( ${available_agents[(Ie)$agent]} == 0 )); then
    print -u2 "devws: unknown agent '$agent' (choose: ${available_agents[*]})"
    return 2
  fi

  local -a available_editors
  available_editors=(${=DEVWS_EDITORS:-nvim vim code zed})

  if [[ "$template" != dev ]]; then
    editor="-"
  elif [[ -z "$editor" ]] && (( attach )) && [[ -t 0 && -t 1 && -x "$(command -v fzf)" ]]; then
    editor="$(printf '%s\n' "${available_editors[@]}" | fzf \
      --height=~10 --layout=reverse --prompt='Editor > ')"
    [[ -n "$editor" ]] || return 0
  fi
  editor="${editor:-${DEVWS_DEFAULT_EDITOR:-${available_editors[1]}}}"

  if [[ "$template" == dev ]] && (( ${available_editors[(Ie)$editor]} == 0 )); then
    print -u2 "devws: unknown editor '$editor' (choose: ${available_editors[*]})"
    return 2
  fi

  # After a reboot or a crash there is no tmux server: rebuild the saved
  # workspaces before adding the requested one. A no-op while a server is
  # running, so a workspace that was deliberately closed is never resurrected.
  if [[ "${DEVWS_AUTO_RESTORE:-1}" != 0 ]] &&
      ! tmux list-sessions >/dev/null 2>&1 &&
      [[ -s "$HOME/.devws-state/sessions.tsv" ]]; then
    "$HOME/.tmuxinator/restore_state.sh" >/dev/null
  fi

  # A task's folders are the program's to reopen: with its agent's arguments
  # lost, a reopened one would start a plain agent.
  [[ -n "$task" ]] || "$HOME/.tmuxinator/recent.sh" add "$project_root" "$agent" "$editor"
  local -a start_options=() start_settings=(project_root="$project_root" agent="$agent" editor="$editor")
  (( attach )) || start_options=(--no-attach)
  [[ -z "$agent_args" ]] || start_settings+=(agent_args="$agent_args")
  [[ -z "$task" ]] || start_settings+=(task="$task")
  start_settings+=("${extra_settings[@]}")
  tmuxinator start ${start_options[@]} "$template" "${start_settings[@]}"

  # tmux writes . and : of the folder's name as _.
  local session="dev-${project_root:t}"
  session="${session//[.:]/_}"
  if (( ! attach )) && ! tmux has-session -t "=$session" 2>/dev/null; then
    print -u2 "devws: the workspace $session did not start"
    return 1
  fi
  [[ -z "$task" ]] || tmux set-option -t "=$session:" @devws_task "$task"
  if (( ! attach )); then
    # tmuxinator creates the panes at once but their commands run later: the
    # workspace is ready, and can be saved, once it has said where it is and
    # its terminal pane has marked itself (as restore_state.sh waits).
    local attempt
    for attempt in {1..300}; do
      [[ -n "$(tmux show-option -qv -t "=$session:" @devws_root)" ]] &&
        tmux list-panes -s -t "=$session" -F '#{@devws_role}' | grep -qxE 'terminal|team-log' && break
      sleep 0.1
    done
  fi
  "$HOME/.tmuxinator/save_state.sh"
  [[ -n "$TMUX" || -n "$task" ]] && "$HOME/.tmuxinator/refresh_devws_pickers.sh"
  (( attach )) || print -r -- "$session"
  return 0
}

# Prints the folder of <branch>'s worktree of <repo>, and opens nothing. A
# GitHub repo (owner/repo or a URL) is cloned when needed; the branch starts
# from the freshly fetched default branch and gets the repo's untracked files
# (.shared). A folder gets its worktree beside it (worktree.sh).
devws-worktree-ensure() {
  local repo="${1:-}" branch="${2:-}" bare folder base
  if [[ -z "$repo" || -z "$branch" || $# -gt 2 ]]; then
    print -u2 "usage: devws worktree ensure <repo or folder> <branch>"
    return 2
  fi
  if [[ -d "$repo" ]]; then
    "$HOME/.tmuxinator/worktree.sh" ensure "$repo" "$branch"
    return
  fi
  bare="$("$HOME/.tmuxinator/github_repo.sh" ensure "$repo")" || return
  base="origin/$("$HOME/.tmuxinator/github_repo.sh" default-branch "$bare")"
  folder="$("$HOME/.tmuxinator/worktree.sh" ensure "$bare" "$branch" "$base")" || return
  "$HOME/.tmuxinator/shared_files.sh" link "${bare:h}" "$folder" || return
  print -r -- "$folder"
}

devws-restore() {
  local attach=1
  local restored first

  if [[ "${1:-}" == "--no-attach" ]]; then
    attach=0
  elif (( $# > 0 )); then
    print -u2 "usage: devws restore [--no-attach]"
    return 2
  fi

  restored="$("$HOME/.tmuxinator/restore_state.sh")" || return
  first="${restored%%$'\n'*}"

  if [[ -z "$first" ]]; then
    print "devws: no workspaces to restore"
    return 0
  fi

  "$HOME/.tmuxinator/refresh_devws_pickers.sh"
  print "devws: restored ${(w)#restored} workspace(s)"

  (( attach )) || return 0
  if [[ -n "$TMUX" ]]; then
    tmux switch-client -t "$first"
  elif [[ -t 1 ]]; then
    tmux attach -t "$first"
  fi
}

# The workspace's repo in jungleforge (jungleforge.sh): `devws run` runs this
# branch, `devws run <branch|main>` another, `devws stop` stops the apps.
# The repo folder a command acts on: the workspace's, or the current one's.
devws-root() {
  local root=""
  if [[ -n "$TMUX" && "$(tmux display-message -p ${TMUX_PANE:+-t "$TMUX_PANE"} '#S')" == dev-* ]]; then
    root="$(tmux show-options -v ${TMUX_PANE:+-t "$TMUX_PANE"} @devws_root 2>/dev/null)"
  fi
  git -C "${root:-$PWD}" rev-parse --show-toplevel 2>/dev/null
}

# `devws run`, `devws run <branch|main>` and `devws stop` start background
# jobs (job.sh): the header shows them while you carry on.
devws-run() {
  local action="$1" target="${2:-}" root folder rows app
  local jungleforge="$HOME/.tmuxinator/jungleforge.sh"
  local -a apps locks

  if ! root="$(devws-root)"; then
    print -u2 "devws $action: not in a git repo"
    return 2
  fi
  rows="$("$jungleforge" apps "$root")" || return 2
  apps=("${(@f)$(cut -f1 <<<"$rows")}")
  # Jobs on one app run one after another.
  for app in "${apps[@]}"; do
    locks+=(--lock "$app")
  done

  if [[ "$action" == stop ]]; then
    "$HOME/.tmuxinator/job.sh" start "${apps[*]} → stop" "${locks[@]}" -- "$jungleforge" stop "$root" "${apps[@]}"
    return
  fi
  folder="$root"
  if [[ -n "$target" ]]; then
    folder="$("$jungleforge" targets "$root" | awk -F '\t' -v target="$target" '$1 == target { print $2; exit }')"
    if [[ -z "$folder" ]]; then
      print -u2 "devws run: no branch '$target' (choose: $("$jungleforge" targets "$root" | cut -f1 | paste -sd ' ' -))"
      return 2
    fi
  fi
  "$HOME/.tmuxinator/job.sh" start "${apps[*]} → ${target:-$(git -C "$folder" branch --show-current)}" \
    "${locks[@]}" -- "$jungleforge" run "$folder" "${apps[@]}"
}

# `devws push`: the PR question first, then the push as a background job.
devws-push() {
  local root pr
  if ! root="$(devws-root)"; then
    print -u2 "devws push: not in a git repo"
    return 2
  fi
  pr="$(DEVWS_ROOT="$root" "$HOME/.tmuxinator/git_actions.sh" ask-pr)" || return
  "$HOME/.tmuxinator/job.sh" start "Push $(git -C "$root" branch --show-current)" -- \
    env DEVWS_ROOT="$root" "$HOME/.tmuxinator/git_actions.sh" push --pr "$pr"
}

# `devws jobs` lists the background jobs; `devws jobs log [id]` pages one.
devws-jobs() {
  case "${1:-}" in
    log) "$HOME/.tmuxinator/job.sh" log "${2:-}" ;;
    '') "$HOME/.tmuxinator/job.sh" list ;;
    *) print -u2 "usage: devws jobs [log [id]]"; return 2 ;;
  esac
}

# ai-memory (memory.sh): `devws memory search <question>` asks this
# workspace's agent to search its memory; recent, web, doctor; wire re-wires
# every agent account.
devws-memory() {
  local memory="$HOME/.tmuxinator/memory.sh" session
  case "${1:-}" in
    search)
      [[ -n "${2:-}" ]] || { print -u2 "usage: devws memory search <question>"; return 2; }
      session="$(tmux display-message -p ${TMUX_PANE:+-t "$TMUX_PANE"} '#S' 2>/dev/null)"
      [[ "$session" == dev-* ]] || { print -u2 "devws memory search: run it in a workspace"; return 2; }
      "$memory" ask "$session" "${*:2}"
      ;;
    recent) "$memory" recent "$(devws-root || print -r -- "$PWD")" ;;
    web | doctor) "$memory" "$1" ;;
    wire) "$memory" wire-all --force ;;
    *)
      print -u2 "usage: devws memory {search <question>|recent|web|doctor|wire}"
      return 2
      ;;
  esac
}

devws-markdown() {
  local markdown_file
  local self_dir="$devws_checkout/shell"

  if (( $# > 1 )); then
    print -u2 "usage: devws md [file.md]"
    return 2
  fi
  if ! command -v glow >/dev/null 2>&1; then
    print -u2 "devws md: Glow is required; run ./install.sh --deps"
    return 127
  fi

  if (( $# == 1 )); then
    markdown_file="$1"
  else
    if ! command -v fzf >/dev/null 2>&1; then
      print -u2 "devws md: fzf is required for interactive selection"
      return 127
    fi
    markdown_file="$(
      find . -type f \
        \( -iname '*.md' -o -iname '*.markdown' \) \
        ! -path '*/.git/*' -print |
        LC_ALL=C sort |
        fzf --height=~60% --layout=reverse \
          --prompt='Markdown > ' \
          --header='Choose a Markdown file to open with Glow'
    )"
    [[ -n "$markdown_file" ]] || return 0
  fi

  if [[ ! -f "$markdown_file" ]]; then
    print -u2 "devws md: file not found: $markdown_file"
    return 2
  fi
  if [[ ! -r "$markdown_file" ]]; then
    print -u2 "devws md: file is not readable: $markdown_file"
    return 2
  fi
  case "${markdown_file:l}" in
    *.md|*.markdown) ;;
    *)
      print -u2 "devws md: expected a .md or .markdown file"
      return 2
      ;;
  esac

  local mermaid_script="$self_dir/render_mermaid_preview.sh"
  [[ -x "$mermaid_script" ]] && "$mermaid_script" "$markdown_file"

  command glow -p "$markdown_file"
}

devws-menu() {
  local action="${1:-toggle}"
  local session="${2:-}"
  local window picker

  if [[ -z "$TMUX" ]]; then
    print -u2 "devws menu: run this command inside tmux"
    return 1
  fi

  session="${session:-$(tmux display-message -p '#S')}"
  [[ "$session" == dev-* ]] || session="dev-$session"
  window="$session:workspace"

  if ! tmux list-windows -t "$session" -F '#{window_name}' 2>/dev/null |
      grep -qx 'workspace'; then
    print -u2 "devws menu: workspace window not found in '$session'"
    return 1
  fi

  picker="$(
    tmux list-panes -t "$window" -F '#{pane_id}|#{pane_title}' 2>/dev/null |
      awk -F '|' '$2 == "devws-picker" { print $1; exit }'
  )"

  case "$action" in
    open)
      [[ -n "$picker" ]] && return 0
      tmux split-window -d -f -h -b -l 25% -t "$window" \
        "$HOME/.tmuxinator/session_picker.sh"
      ;;
    close)
      [[ -z "$picker" ]] || tmux kill-pane -t "$picker"
      ;;
    toggle)
      if [[ -n "$picker" ]]; then
        tmux kill-pane -t "$picker"
      else
        tmux split-window -d -f -h -b -l 25% -t "$window" \
          "$HOME/.tmuxinator/session_picker.sh"
      fi
      ;;
    *)
      print -u2 "usage: devws menu {open|close|toggle} [workspace]"
      return 2
      ;;
  esac

  "$HOME/.tmuxinator/save_state.sh"
}

devws "$@"
