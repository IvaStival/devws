# Agent commands offered by devws. The first matching name is passed directly
# to the tmuxinator agent pane.
DEVWS_AGENTS="claude codex"
DEVWS_DEFAULT_AGENT="claude"

# Editors offered by devws. Terminal editors run inside the editor pane.
# VS Code and Zed are opened through their CLI and kept attached with --wait.
DEVWS_EDITORS="nvim vim code zed"
DEVWS_DEFAULT_EDITOR="nvim"

# Set to 0 to stop devws from reopening the previously saved workspaces the
# first time it runs with no tmux server. State lives in
# ~/.devws-state/sessions.tsv; clear it with `devws fresh`.
DEVWS_AUTO_RESTORE=1

# The header's weather (wttr.in). Empty: located by your IP; or a place such
# as "Lisbon" or "São Paulo".
DEVWS_WEATHER_LOCATION=""

# Set to 0 to hide the header's ghost.
DEVWS_HEADER_PET=1
