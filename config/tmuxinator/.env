# Agents offered by devws, shown in this order in the header. Register and
# remove them from the devws menu (Agent tab), which edits these lines. Each
# name runs DEVWS_AGENT_<name>="<kind> <folder>": the program (claude or codex)
# and its config folder (CLAUDE_CONFIG_DIR or CODEX_HOME), so one program can
# run several accounts. A bare "claude" or "codex" needs no line: it runs in
# ~/.claude or ~/.codex. Names use letters, digits and _.
DEVWS_AGENTS="claude codex claude_work"
DEVWS_DEFAULT_AGENT="claude"
DEVWS_AGENT_claude_work="claude ~/.claude-work"

# Editors offered by devws. Terminal editors run inside the editor pane.
# VS Code and Zed are opened through their CLI and kept attached with --wait.
DEVWS_EDITORS="nvim vim code zed"
DEVWS_DEFAULT_EDITOR="nvim"

# Set to 0 to stop devws from reopening the previously saved workspaces the
# first time it runs with no tmux server. State lives in
# ~/.devws-state/sessions.tsv; clear it with `devws fresh`.
DEVWS_AUTO_RESTORE=1

# The header's weather (wttr.in). Empty: located by your IP; or a place such
# as "Lisbon" or "São Paulo".
DEVWS_WEATHER_LOCATION=""

# macOS notifications when an agent in a workspace you are not looking at
# needs you or is done: 1 for both, "waiting" for needs-you only, 0 for none.
DEVWS_NOTIFY=1

# Set to 0 to hide the header's ghost.
DEVWS_HEADER_PET=1

# Minutes a workspace stays unseen, its agent idle or done, before its agent,
# editor and sidebar are frozen until you switch back. 0 never freezes.
DEVWS_SUSPEND_AFTER=15
